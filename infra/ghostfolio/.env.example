# Ghostfolio stack configuration.
#
# Copy to `.env`, fill in real values, then `chmod 600 .env` (§11.6).
# `.env` is gitignored. Never commit it, never bake it into an image layer,
# never paste its contents into a log or an issue.
#
# Generate each secret with:
#   openssl rand -hex 32

COMPOSE_PROJECT_NAME=ghostfolio

# ── Exposure ────────────────────────────────────────────────────────────────
# Interface Ghostfolio binds to on the host. Loopback by default.
# Set to the NAS LAN address (e.g. 192.168.0.100) to reach the UI from
# another machine on the LAN.
# NEVER set this to 0.0.0.0, and never add a router port-forward (§11.2).
GHOSTFOLIO_BIND_IP=127.0.0.1
GHOSTFOLIO_PORT=3333

# ── Cache ───────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=<INSERT_REDIS_PASSWORD>

# ── Database ────────────────────────────────────────────────────────────────
POSTGRES_DB=ghostfolio-db
POSTGRES_USER=ghostfolio
POSTGRES_PASSWORD=<INSERT_POSTGRES_PASSWORD>

# ── Application ─────────────────────────────────────────────────────────────
ACCESS_TOKEN_SALT=<INSERT_RANDOM_STRING>
JWT_SECRET_KEY=<INSERT_RANDOM_STRING>
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?connect_timeout=300
